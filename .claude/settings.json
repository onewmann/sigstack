{
  "permissions": {
    "allow": [
      "Bash(pixi run:*)",
      "Bash(pixi install)",
      "Bash(pixi list:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh pr view:*)",
